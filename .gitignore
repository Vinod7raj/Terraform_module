# Terraform working directory
.terraform/

# Terraform state files (may contain secrets)
*.tfstate
*.tfstate.*
crash.log
crash.*.log

# Variable files (may contain credentials or secrets)
*.tfvars
*.tfvars.json
!example.tfvars

# Override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Terraform CLI configuration (may contain credentials)
.terraformrc
terraform.rc

# Local plan files
*.tfplan
tfplan

# OS/editor files
.DS_Store
Thumbs.db
.vscode/
